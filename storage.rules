rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Médias de chat (images, audio)
    // chatId = "uid1_uid2" trié — on vérifie que l'uid est dans le path
    match /chat_media/{chatId}/{fileName} {
      allow read: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid);
      allow write: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*');
    }

    // Fonds d'écran de chat — fileName attendu au format "{uid1}_{uid2}.jpg"
    // (chatId trié). On exige que l'uid soit participant du chat.
    match /chat_wallpapers/{fileName} {
      allow read: if request.auth != null
        && (fileName.matches('^' + request.auth.uid + '_.+\\.jpg$')
         || fileName.matches('^.+_' + request.auth.uid + '\\.jpg$'));
      allow write: if request.auth != null
        && (fileName.matches('^' + request.auth.uid + '_.+\\.jpg$')
         || fileName.matches('^.+_' + request.auth.uid + '\\.jpg$'))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
