rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Médias de chat (images, audio)
    // chatId = "uid1_uid2" trié — on vérifie que l'uid est dans le path
    match /chat_media/{chatId}/{fileName} {
      allow read: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid);
      allow write: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*');
    }

    // Fonds d'écran de chat
    match /chat_wallpapers/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
