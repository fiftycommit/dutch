rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Médias de chat (images, audio)
    // chatId = "uid1_uid2" trié — on vérifie que l'uid est dans le path
    match /chat_media/{chatId}/{fileName} {
      allow read: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid);
      allow create: if request.auth != null
        && (chatId.split('_')[0] == request.auth.uid
         || chatId.split('_')[1] == request.auth.uid)
        && request.resource.size < 10 * 1024 * 1024
        && fileName.matches('^.+\\.enc$')
        && request.resource.contentType == 'application/octet-stream';
    }

    // Fonds d'écran de chat — fileName attendu au format "{uid1}_{uid2}.enc"
    // (chatId trié). On exige que l'uid soit participant du chat.
    match /chat_wallpapers/{fileName} {
      allow read: if request.auth != null
        && (fileName.matches('^' + request.auth.uid + '_.+\\.enc$')
         || fileName.matches('^.+_' + request.auth.uid + '\\.enc$'));
      allow create, update: if request.auth != null
        && (fileName.matches('^' + request.auth.uid + '_.+\\.enc$')
         || fileName.matches('^.+_' + request.auth.uid + '\\.enc$'))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if request.auth != null
        && (fileName.matches('^' + request.auth.uid + '_.+\\.enc$')
         || fileName.matches('^.+_' + request.auth.uid + '\\.enc$'));
    }

    // Refuser tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
