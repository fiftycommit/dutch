{
  "name": "dutch-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run clean && npm run build && node --test-concurrency=1 --test dist/__tests__/*.test.js",
    "test:coverage": "npm run clean && npm run build && c8 --all --src src --exclude-after-remap --exclude 'src/__tests__/**' --reports-dir coverage --reporter=lcov --reporter=text node --enable-source-maps --test-force-exit --test-concurrency=1 --test dist/__tests__/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.1",
    "rate-limiter-flexible": "^9.0.1",
    "redis": "^5.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "c8": "^10.1.3",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
