rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: l'utilisateur authentifié est un participant du chat
    // Le chatId est "{uid1}_{uid2}" trié alphabétiquement
    function isParticipant(chatId) {
      let parts = chatId.split('_');
      return request.auth != null
        && parts.size() == 2
        && (request.auth.uid == parts[0] || request.auth.uid == parts[1]);
    }

    match /private_chats/{chatId} {
      // Seuls les participants peuvent lire/écrire les métadonnées du chat
      allow read, write: if isParticipant(chatId);

      match /messages/{messageId} {
        // Seuls les participants peuvent lire les messages
        allow read: if isParticipant(chatId);
        // Un participant peut créer un message seulement en son propre nom
        // Cap sur text (chiffré côté client → overhead base64) pour éviter
        // qu'un XSS n'insère des docs massifs.
        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && (!('text' in request.resource.data)
              || request.resource.data.text is string
                 && request.resource.data.text.size() <= 16000);
        // Les updates sont strictement limités aux champs de suppression
        // (empêche un participant d'altérer senderId/content/timestamp d'un
        // message existant, y compris ceux de l'autre participant).
        allow update: if isParticipant(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deletedFor', 'deletedForAll']);
      }
    }

    // Refuser tout le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
