rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: l'utilisateur authentifié est un participant du chat
    // Le chatId est "{uid1}_{uid2}" trié alphabétiquement
    function isParticipant(chatId) {
      let parts = chatId.split('_');
      return request.auth != null
        && parts.size() == 2
        && (request.auth.uid == parts[0] || request.auth.uid == parts[1]);
    }

    match /private_chats/{chatId} {
      // Seuls les participants peuvent lire/écrire les métadonnées du chat
      allow read, write: if isParticipant(chatId);

      match /messages/{messageId} {
        // Seuls les participants peuvent lire les messages
        allow read: if isParticipant(chatId);
        // Un participant peut créer un message seulement en son propre nom
        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;
        // Un participant peut mettre à jour un message (deletedFor, deletedForAll)
        allow update: if isParticipant(chatId);
      }
    }

    // Refuser tout le reste par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
